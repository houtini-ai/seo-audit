{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false
  },
  "include": [
    "src/ui/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
