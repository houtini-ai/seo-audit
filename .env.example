# SEO Audit Console — environment variables
# Configure these in your MCP client (e.g. claude_desktop_config.json "env"), or export them
# when running the local scripts. Only GOOGLE_APPLICATION_CREDENTIALS is required.

# Path to a Google Cloud service-account JSON key with Search Console API access.
# (Add the service account's email as a user on each GSC property you want to audit.)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Where per-property SQLite databases + exported reports are stored.
# Defaults to ~/Documents/seo-audit-console if unset.
SAC_DATA_DIR=/absolute/path/to/seo-audit-console-data

# Optional — DataForSEO credentials unlock keyword volume, SERP, search-intent,
# competitor/content-gap, lab Core Web Vitals, and backlink tools.
# Create an account: https://dataforseo.com/?aff=213701
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# Optional — DataForSEO response cache TTL in days (default 20).
DATAFORSEO_CACHE_DAYS=20

# Optional — Majestic API key. Enriches link_intersect prospects with Trust Flow +
# Topical Trust Flow and re-sorts by real authority (kills directory noise: a DataForSEO
# rank-227 domain is often Trust Flow 0). Billed in Majestic resource units — roughly one
# per prospect enriched, batched 100 per call, capped by the tool's enrichLimit (default 100).
# link_intersect works without it (DataForSEO domain rank). https://majestic.com/plans-pricing
MAJESTIC_API_KEY=
# Optional — Majestic response cache TTL in days (default 20). Cache hits cost no units.
MAJESTIC_CACHE_DAYS=20
# Optional/advanced — override the Majestic host. Default is the live API (api.majestic.com);
# https://developer.majestic.com is their frozen 2015 sandbox, for testing the wiring free.
MAJESTIC_API_HOST=

# Optional — Firecrawl key. Lets content recon (recon_targets scrapeCompetitors:true) fetch
# competitor pages as clean markdown. Recon works without it. https://firecrawl.link/2d1PLD8
FIRECRAWL_API_KEY=

# Optional — Supadata key. Lets content recon transcribe the ranking videos (YouTube/TikTok/X).
# Recon works without it, it just skips video. https://supadata.ai
SUPADATA_API_KEY=

# Optional/advanced — pin the local passage-scoring model to a device: dml (DirectX 12 GPU on
# Windows) or cpu. Unset, it tries the GPU and falls back to CPU by itself.
SAC_RERANK_DEVICE=
