# Keep the Docker build context tiny — the image rebuilds node_modules/dist from
# source (see Dockerfile), so none of the regenerable or local-only trees belong in it.
node_modules
dist
mcpb-dist
mcpb-staging
.git
.github

# Local data + secrets — must never enter an image (not even the build layer)
*.db
*.db-wal
*.db-shm
.secrets
.claude
.env
.env.*
# Credential files and tokens (mirror .gitignore; defense-in-depth for the build context)
CLAUDE.md
*-credentials.json
credentials.json
gsc*.json
service-account*.json
*.pem
*.p12
*.pfx
.mcpregistry_*

# Build caches / logs
*.tsbuildinfo
*.log
.vite
.preview

# Not needed to build or run the server
scripts
research
plan
manual
docs
crawl-tests
findings
assets
images
ARCHITECTURE.md
data-smoke.md
CHANGELOG.md
