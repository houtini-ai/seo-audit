{
  "name": "@houtini/seo-audit-console",
  "version": "1.0.0",
  "mcpName": "io.github.houtini-ai/seo-audit-console",
  "description": "The complete technical SEO audit at conversation speed: Google Search Console history + a first-party crawl + on-demand DataForSEO, merged into one prioritised audit inside Claude - 143 checks ranked by recoverable clicks, with paste-ready fixes, keyword and content-gap research, and AI-search readiness.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "seo-audit-console": "dist/index.js",
    "seo-audit-dashboard": "dist/dashboard.js",
    "seo-audit-runner": "dist/runner.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "author": "Richard Baxter <hello@houtini.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houtini-ai/seo-audit.git"
  },
  "keywords": [
    "seo",
    "technical-seo",
    "seo-audit",
    "search-console",
    "google-search-console",
    "crawler",
    "site-audit",
    "dataforseo",
    "keyword-research",
    "content-gap",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-search",
    "structured-data",
    "core-web-vitals"
  ],
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui:dashboard": "cross-env INPUT=src/ui/dashboard.html vite build",
    "build:ui:sync": "cross-env INPUT=src/ui/sync-progress.html vite build",
    "build:ui:portfolio": "cross-env INPUT=src/ui/portfolio.html vite build",
    "build:ui": "npm run build:ui:dashboard && npm run build:ui:sync && npm run build:ui:portfolio",
    "build": "npm run build:server && npm run typecheck:ui && npm run build:ui",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "dev": "tsc -p tsconfig.server.json --watch",
    "start": "node dist/index.js",
    "test": "npm run build:server && npm run smoke && npm run probe:jobs && npm run probe:runner && npm run probe:fts && npm run probe:review-0-15 && npm run probe:summary && npm run probe:gsc-rows && npm run probe:brand && npm run probe:ratelimit && npm run probe:signals && npm run probe:redirects && npm run probe:ecommerce && npm run probe:gsc-storage && npm run probe:hreflang && npm run probe:assets && npm run probe:soft404 && npm run probe:render-divergence && npm run probe:dashboard-rules && npm run probe:dashboard-container && npm run probe:audit-size && npm run probe:priority-calibration && npm run probe:a11y-rollup && npm run probe:data-storage && npm run probe:runner-stopped && npm run probe:reply-latency && npm run probe:regrouped-deltas && npm run probe:startup-hints && npm run probe:portfolio && npm run probe:web && npm run probe:ssrf",
    "smoke": "node scripts/smoke.mjs",
    "probe:dashboard-rules": "node scripts/probe-dashboard-rules.mjs",
    "probe:runner-stopped": "node scripts/probe-runner-stopped.mjs",
    "probe:data-storage": "node scripts/probe-data-storage.mjs",
    "probe:a11y-rollup": "node scripts/probe-a11y-rollup.mjs",
    "probe:priority-calibration": "node scripts/probe-priority-calibration.mjs",
    "probe:audit-size": "node scripts/probe-audit-size.mjs",
    "probe:dashboard-container": "node scripts/probe-dashboard-container.mjs",
    "demo:property": "node scripts/demo-property.mjs",
    "demo:screenshots": "node scripts/demo-screenshots.mjs",
    "probe:crawl": "node scripts/probe-crawl.mjs",
    "qa:crawl": "node scripts/qa-crawl.mjs",
    "probe:gsc": "node scripts/probe-gsc.mjs",
    "probe:fixfinding": "node scripts/probe-fixfinding.mjs",
    "probe:schema": "node scripts/probe-schema.mjs",
    "probe:schema-rules": "node scripts/probe-schema-rules.mjs",
    "probe:signals": "node scripts/probe-signals.mjs",
    "probe:redirects": "node scripts/probe-redirects.mjs",
    "probe:ecommerce": "node scripts/probe-ecommerce.mjs",
    "probe:hreflang": "node scripts/probe-hreflang.mjs",
    "probe:assets": "node scripts/probe-assets.mjs",
    "probe:soft404": "node scripts/probe-soft404.mjs",
    "probe:render-divergence": "node scripts/probe-render-divergence.mjs",
    "probe:extract": "node scripts/probe-extract.mjs",
    "probe:jobs": "node scripts/probe-jobs.mjs",
    "probe:runner": "node scripts/probe-runner.mjs",
    "probe:crawl-local": "node scripts/probe-crawl-local.mjs",
    "probe:checks-v2": "node scripts/probe-checks-v2.mjs",
    "probe:integrity": "node scripts/probe-integrity.mjs",
    "probe:probeurls": "node scripts/probe-probeurls.mjs",
    "probe:triage404": "node scripts/probe-triage404.mjs",
    "probe:fts": "node scripts/probe-fts.mjs",
    "probe:external": "node scripts/probe-external.mjs",
    "probe:blocking": "node scripts/probe-blocking.mjs",
    "probe:extract2": "node scripts/probe-extract2.mjs",
    "probe:charset": "node scripts/probe-charset-fixture.mjs",
    "probe:a11y": "node scripts/probe-a11y.mjs",
    "probe:neardup": "node scripts/probe-neardup.mjs",
    "probe:backlinks": "node scripts/probe-backlinks.mjs",
    "probe:dfs-labs": "node scripts/probe-dfs-labs.mjs",
    "probe:dfs-datefrom": "node scripts/probe-dfs-datefrom.mjs",
    "probe:6a": "node scripts/probe-6a.mjs",
    "probe:priority": "node scripts/probe-priority.mjs",
    "probe:templates": "node scripts/probe-templates.mjs",
    "probe:6b": "node scripts/probe-6b.mjs",
    "probe:6c": "node scripts/probe-6c.mjs",
    "probe:6d": "node scripts/probe-6d.mjs",
    "probe:migrate": "node scripts/probe-migrate.mjs",
    "probe:boot": "node scripts/probe-boot.mjs",
    "probe:drift-fixes": "node scripts/probe-drift-fixes.mjs",
    "probe:majestic": "node scripts/probe-majestic.mjs",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "probe:review-0-15": "node scripts/probe-review-0-15.mjs",
    "probe:startup-hints": "node scripts/probe-startup-hints.mjs",
    "probe:web": "node scripts/probe-web-unified.mjs",
    "probe:portfolio": "node scripts/probe-portfolio.mjs",
    "probe:summary": "node scripts/probe-summary.mjs",
    "probe:gsc-rows": "node scripts/probe-gsc-rows.mjs",
    "probe:gsc-storage": "node scripts/probe-gsc-storage.mjs",
    "probe:brand": "node scripts/probe-brand.mjs",
    "probe:ratelimit": "node scripts/probe-ratelimit.mjs",
    "probe:reply-latency": "node scripts/probe-reply-latency.mjs",
    "probe:regrouped-deltas": "node scripts/probe-regrouped-deltas.mjs",
    "probe:ssrf": "node scripts/probe-ssrf.mjs",
    "typecheck:ui": "tsc -p tsconfig.ui.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@googleapis/searchconsole": "^11.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "google-auth-library": "^11.3.2",
    "undici": "^8.7.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.2.8",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "cross-env": "^10.1.0",
    "echarts": "^6.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "homepage": "https://github.com/houtini-ai/seo-audit#readme",
  "bugs": {
    "url": "https://github.com/houtini-ai/seo-audit/issues"
  }
}
